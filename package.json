{
  "name": "future-star-u15",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/audit-fixes.test.mjs",
    "postinstall": "prisma generate",
    "db:push": "tsx scripts/run-prisma.ts db push",
    "db:bootstrap": "tsx scripts/bootstrap-mysql.ts",
    "db:migrate-from-sqlite": "tsx scripts/migrate-sqlite-to-mysql.ts",
    "db:seed": "tsx scripts/run-prisma.ts db seed",
    "db:seed:trial-zones": "tsx scripts/run-ts-with-env.ts prisma/seed-trial-zones.ts",
    "db:seed:trial-schedule": "tsx scripts/run-ts-with-env.ts prisma/seed-trial-schedule.ts",
    "db:normalize-registrations": "tsx scripts/run-ts-with-env.ts scripts/normalize-pending-registrations.ts",
    "db:verify-registrations": "tsx scripts/verify-registration-fields.ts",
    "db:add-code-columns": "tsx scripts/add-registration-code-columns.ts",
    "db:backfill-codes": "tsx scripts/backfill-registration-codes.ts",
    "db:generate": "prisma generate",
    "admin:hash": "node -e \"const b=require('bcryptjs');const p=process.argv[1]||'changeme';console.log(Buffer.from(b.hashSync(p,12)).toString('base64'))\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
