# =============================================================================
# Future Star U-15 — environment template
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

DATABASE_URL="file:./prisma/production.db"

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME="admin"

# Option A: /admin/setup with ADMIN_SETUP_SECRET (writes data/admin-credentials.json)
ADMIN_SETUP_SECRET=""
# After first successful setup on production:
ADMIN_SETUP_DISABLED=true

# Option B: bcrypt hash in .env
# npm run admin:hash -- 'YourStrongPassword'
ADMIN_PASSWORD_HASH_B64=""

ADMIN_JWT_SECRET=""
# Separate from ADMIN_JWT_SECRET in production (registration receipts + OTP)
REGISTRATION_TOKEN_SECRET=""

# Set true on Vercel/production so rate limits use the real client IP from the edge proxy
TRUST_PROXY_HEADERS=true

# ADMIN_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Site URL (links in registration emails — server-only, not exposed to browser)
# -----------------------------------------------------------------------------
APP_URL="https://futurestarchampion.com"

# -----------------------------------------------------------------------------
# MSG91 Email (transactional templates)
# https://msg91.com/email — create templates and paste template IDs below
# -----------------------------------------------------------------------------
MSG91_AUTH_KEY=""
MSG91_EMAIL_DOMAIN=""
MSG91_EMAIL_FROM=""
MSG91_EMAIL_FROM_NAME="Future Star U-15"
# Optional override:
# MSG91_EMAIL_API_URL="https://control.msg91.com/api/v5/email/send"
# Template variables — confirmation: player_name, print_link, status_link
MSG91_TEMPLATE_REGISTRATION_CONFIRMATION=""
# Template variables — OTP: player_name, otp (or OTP)
MSG91_TEMPLATE_REGISTRATION_OTP=""
