DATABASE_URL="file:./dev.db"
ADMIN_USERNAME="admin"
# Recommended: base64-encoded bcrypt hash (avoids Next.js "$" expansion in .env)
# node -p 'Buffer.from(require("bcryptjs").hashSync("YOUR_PASSWORD",12)).toString("base64")'
ADMIN_PASSWORD_HASH_B64=""
# Optional legacy: only if every "$" in the bcrypt string is escaped as "$$"
# ADMIN_PASSWORD_HASH=""
ADMIN_JWT_SECRET="replace-with-long-random-string-at-least-32-characters"
