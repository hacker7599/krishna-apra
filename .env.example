DATABASE_URL="file:./prisma/production.db"

ADMIN_USERNAME="admin"
# Option A (recommended on VPS): use /admin/setup with ADMIN_SETUP_SECRET — writes data/admin-credentials.json
ADMIN_SETUP_SECRET=""
# Set to true after first successful setup to block the setup page
# ADMIN_SETUP_DISABLED=true

# Option B: bcrypt hash in .env (base64 avoids Next.js "$" expansion)
# node -p 'Buffer.from(require("bcryptjs").hashSync("YOUR_PASSWORD",12)).toString("base64")'
ADMIN_PASSWORD_HASH_B64=""

ADMIN_JWT_SECRET="replace-with-long-random-string-at-least-32-characters"

# Cookie: auto-detect HTTPS via X-Forwarded-Proto. Force if needed:
# ADMIN_COOKIE_SECURE=true
# ADMIN_COOKIE_SECURE=false
