# =============================================================================
# Future Star U-15 — environment template
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# MySQL (XAMPP / production). Create DB first — see docs/MYSQL-XAMPP.md
# The app builds the connection URL from these values (do not paste a full URL here).
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="future_star_u15"

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME="admin"

# Option A: /admin/setup with ADMIN_SETUP_SECRET (writes data/admin-credentials.json)
ADMIN_SETUP_SECRET=""
# After first successful setup on production:
ADMIN_SETUP_DISABLED=true

# Option B: bcrypt hash in .env
# npm run admin:hash -- 'YourStrongPassword'
ADMIN_PASSWORD_HASH_B64=""

ADMIN_JWT_SECRET=""
# Separate from ADMIN_JWT_SECRET in production (registration receipts + OTP)
REGISTRATION_TOKEN_SECRET=""

# Set true on Vercel/production so rate limits use the real client IP from the edge proxy
TRUST_PROXY_HEADERS=true

# ADMIN_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Recommended: Razorpay Dashboard → Webhooks → payment.captured + payment.authorized
# URL: https://your-domain.com/api/payments/webhook
# Does NOT create registrations — only marks payment orders paid for admin/audit.
# Registration is created only after successful checkout + /api/register verification.
RAZORPAY_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Site URL (links in registration emails — server-only, not exposed to browser)
# -----------------------------------------------------------------------------
APP_URL="https://futurestarchampion.com"

# Optional: full registered office address shown in footer and legal pages
# LEGAL_REGISTERED_ADDRESS="TBCL SPORTS PRIVATE LIMITED, [full postal address], Delhi NCR, India"

# -----------------------------------------------------------------------------
# SMTP (transactional email — HTML templates built in-app)
# Credentials stay in .env only (gitignored). Never commit real passwords.
#
# MSG91 SMTP example: host smtp.mailer91.com, port 587, SMTP_SECURE=false
# Gmail / Google Workspace: smtp.gmail.com, port 587, use an app password
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
# true for port 465 (SSL); false for 587 (STARTTLS)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourdomain.com"
SMTP_FROM_NAME="Future Star U-15"
# Optional reply-to (e.g. registrations@yourdomain.com)
# SMTP_REPLY_TO=""
# Set false only for local dev with self-signed certs (not for production)
# SMTP_TLS_REJECT_UNAUTHORIZED=true
