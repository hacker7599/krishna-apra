generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Registration {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  academyName      String
  playerName       String
  dateOfBirth      DateTime
  roles            String
  email            String
  phone            String
  fatherName       String?
  address          String?
  jerseySize       String?
  shoeSize         String?
  idDocumentType   String?
  idProofPath      String?
  paymentProofPath String?
  transactionRef   String?
  feeReceivedDate  String?
  coachName        String?
}

model Team {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  city        String
  accentColor String
  description String   @default("")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
}

model HeroBanner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String?
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

model TrialZone {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trialPlace      String
  zone            String
  address         String
  navigationUrl   String
  contactDetails  String
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
}
