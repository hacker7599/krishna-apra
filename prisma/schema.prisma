generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PaymentOrder {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  razorpayOrderId   String    @unique
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("created")
  razorpayPaymentId String?
  email             String?
  phone             String?
  playerName        String?
  receipt           String?
  paidAt            DateTime?
  paymentMethod     String?
  registrationId    String?       @unique
  registration      Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  logs              PaymentLog[]
  completionInvite  RegistrationCompletionInvite?
}

model PaymentLog {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  source            String
  eventType         String
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpayEventId   String?  @unique
  amountPaise       Int?
  currency          String?
  status            String?
  email             String?
  phone             String?
  playerName        String?
  registrationId    String?
  paymentOrderId    String?
  paymentOrder      PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  clientIp          String?
  success           Boolean  @default(true)
  message           String?
  metadata          String?  @db.Text

  @@index([razorpayOrderId])
  @@index([createdAt])
  @@index([source])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   String?  @db.Text
  clientIp   String?

  @@index([createdAt])
  @@index([entityType])
}

model EmailLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  templateKey    String
  toEmail        String
  registrationId String?
  success        Boolean  @default(false)
  provider       String   @default("smtp")
  providerMsgId  String?
  error          String?  @db.Text
  metadata       String?  @db.Text

  @@index([createdAt])
  @@index([toEmail])
  @@index([templateKey])
  @@index([registrationId])
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  bucket    String

  @@index([bucket, createdAt])
}

model RegistrationCompletionInvite {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  usedAt          DateTime?
  tokenHash       String    @unique
  paymentOrderId  String    @unique
  paymentOrder    PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  registrationId  String?
  email           String

  @@index([expiresAt])
  @@index([usedAt])
}

model RegistrationAccessOtp {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  email          String
  otpHash        String
  registrationId String
  attempts       Int       @default(0)
  usedAt         DateTime?

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Registration {
  id                    String     @id @default(cuid())
  /// Human-readable ID for status lookup and receipts (e.g. FSU15-R-A1B2C3).
  registrationCode      String?    @unique
  /// Issued when payment is confirmed (e.g. FSU15-P-X9Y8Z7).
  paymentCode           String?    @unique
  createdAt             DateTime   @default(now())
  academyName           String
  playerName            String
  dateOfBirth           DateTime
  roles                 String
  trialZoneId           String?
  trialZone             TrialZone? @relation(fields: [trialZoneId], references: [id], onDelete: SetNull)
  email                 String     @unique
  phone                 String     @unique
  fatherName            String?
  address               String?  @db.Text
  jerseySize            String?
  shoeSize              String?
  idDocumentType        String?
  idProofPath           String?
  playerPhotoPath       String?
  paymentProofPath      String?
  transactionRef        String?
  achievementsAndAwards String?  @db.Text
  feeReceivedDate       String?
  coachName             String?
  paymentStatus         String?
  razorpayOrderId       String?       @unique
  razorpayPaymentId     String?
  paymentOrder          PaymentOrder?
}

model Team {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  name        String
  city        String
  accentColor String   @default("#1B365D")
  logoPath    String?
  description String   @default("")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
}

model HeroBanner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String?
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

model TrialZone {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trialPlace     String
  zone           String
  address        String   @db.Text
  navigationUrl  String?  @db.VarChar(2048)
  contactDetails String?  @db.Text
  sortOrder      Int             @default(0)
  published      Boolean         @default(true)
  registrations  Registration[]
  trialSchedules TrialSchedule[]
}

model TrialSchedule {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  title       String
  scheduledAt DateTime
  endAt       DateTime?
  notes       String?  @db.Text
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  trialZoneId String?
  trialZone   TrialZone? @relation(fields: [trialZoneId], references: [id], onDelete: SetNull)

  @@index([published, scheduledAt])
  @@index([sortOrder])
}

model BlogPost {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  slug            String    @unique
  title           String
  excerpt         String    @default("") @db.VarChar(500)
  content         String    @db.Text
  coverImageUrl   String?
  authorName      String    @default("")
  published       Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?
  ogImageUrl      String?
  canonicalUrl    String?
  robotsNoindex   Boolean   @default(false)

  @@index([published, publishedAt])
  @@index([slug])
}

model AppConfig {
  id            String   @id @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// "razorpay" | "qr_upload" — controls public /register checkout
  paymentMode   String   @default("razorpay")
  paymentQrPath String?
}
